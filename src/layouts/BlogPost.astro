---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: Heading[];
	previousPost?: { id: string; title: string };
	nextPost?: { id: string; title: string };
};

const {
	title,
	description,
	pubDate,
	tags,
	category,
	headings = [],
	previousPost,
	nextPost,
} = Astro.props as Props;
const displayTags = tags ?? [];
const tableOfContents = headings.filter((heading) => heading.depth >= 1 && heading.depth <= 3);
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: min(1240px, calc(100% - 1rem));
				margin: 2.5rem auto 0;
				padding: 0 0 4rem;
			}

			.post-shell {
				display: grid;
				grid-template-columns: 240px minmax(0, 1fr);
				gap: 1.5rem;
				align-items: start;
				color: rgb(var(--black));
			}

			.toc {
				position: sticky;
				top: 8.5rem;
				padding: 0.85rem 0 0.65rem;
				border-left: 4px solid rgba(var(--gray), 16%);
				background: transparent;
			}

			.toc-title {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0 1rem 0.65rem 1rem;
				color: rgba(255, 255, 255, 0.9);
				font-size: 1rem;
				font-weight: 700;
				text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
			}

			.toc-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.toc-item {
				margin: 0;
			}

			.toc-link {
				display: block;
				padding: 0.35rem 1rem;
				color: rgba(255, 255, 255, 0.82);
				text-decoration: none;
				font-size: 1rem;
				line-height: 1.45;
				border-radius: 10px;
				text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
			}

			.toc-link:hover {
				background: rgba(255, 255, 255, 0.08);
			}

			.toc-link.is-active {
				background: rgba(255, 255, 255, 0.14);
				color: #fff;
				font-weight: 700;
			}

			.toc-empty {
				padding: 0 1rem;
				color: rgba(255, 255, 255, 0.7);
				font-size: 0.95rem;
				text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
			}

			.post-shell-inner {
				background: #fff;
				border-radius: 18px;
				padding: 2rem 2.25rem 2.5rem;
				box-shadow: none;
			}

			.post-head {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 0.35rem;
			}

			.post-title-row {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				column-gap: 0.9rem;
				row-gap: 0.2rem;
				min-width: 0;
			}

			.post-title {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				margin: 0;
				font-size: 2.6rem;
				line-height: 1.15;
				text-align: left;
			}

			.post-title::before {
				content: '';
				display: inline-block;
				width: 6px;
				height: 1.05em;
				border-radius: 999px;
				background: #79b7ff;
				flex: 0 0 auto;
			}

			.post-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				color: rgb(var(--gray));
				font-size: 1rem;
				white-space: nowrap;
			}

			.meta-divider {
				color: rgba(var(--gray), 70%);
			}

			.post-description {
				margin: 0;
				color: rgb(var(--gray-dark));
				font-size: 1.08rem;
				line-height: 1.7;
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 0.2rem;
			}

			.tag {
				padding: 0.22rem 0.55rem;
				border-radius: 8px;
				background: rgba(var(--gray), 10%);
				color: rgb(var(--gray-dark));
				font-size: 0.82rem;
			}

			.divider {
				height: 1px;
				margin: 1.2rem 0 1.4rem;
				background: rgba(0, 0, 0, 0.7);
			}

			.content {
				color: rgb(var(--gray-dark));
				font-size: 1.05rem;
				line-height: 1.9;
			}

			.content :global(h1) {
				font-size: 1.8rem;
				line-height: 1.25;
				margin: 1.4rem 0 0.75rem;
			}

			.content :global(h2),
			.content :global(h3),
			.content :global(h4) {
				margin-top: 1.3rem;
			}

			.content :global(h2) {
				font-size: 1.45rem;
				line-height: 1.3;
			}

			.content :global(h3) {
				font-size: 1.2rem;
				line-height: 1.35;
			}

			.content :global(p) {
				margin: 0 0 1rem;
			}

			.content :global(blockquote) {
				border-left: 0;
				padding-left: 0;
				margin-left: 0;
				font-size: inherit;
			}

			.post-nav {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				margin-top: 2rem;
			}

			.post-nav-link,
			.post-nav-empty {
				flex: 1 1 0;
				min-width: 0;
				padding: 0.9rem 1rem;
				border-radius: 12px;
				text-decoration: none;
				transition:
					background-color 0.2s ease,
					transform 0.2s ease,
					box-shadow 0.2s ease;
			}

			.post-nav-link {
				display: grid;
				gap: 0.2rem;
				background: rgba(var(--gray), 8%);
				color: rgb(var(--black));
			}

			.post-nav-link:hover {
				background: rgba(var(--gray), 12%);
				transform: translateY(-1px);
				box-shadow: 0 10px 22px rgba(var(--gray), 10%);
			}

			.post-nav-label {
				color: rgb(var(--gray));
				font-size: 0.84rem;
			}

			.post-nav-title {
				color: rgb(var(--black));
				font-size: 1rem;
				line-height: 1.35;
			}

			.post-nav-empty {
				opacity: 0.35;
				background: rgba(var(--gray), 5%);
			}

			@media (max-width: 980px) {
				.post-shell {
					grid-template-columns: 1fr;
				}

				.toc {
					position: static;
					border-left: 0;
					border-top: 1px solid rgba(var(--gray), 18%);
					background: transparent;
					padding-top: 1rem;
				}
			}

			@media (max-width: 820px) {
				main {
					width: min(100% - 0.5rem, 720px);
					margin-top: 0.5rem;
				}

				.post-shell-inner {
					padding: 1.25rem 1rem 2rem;
				}

				.post-title {
					font-size: 1.9rem;
				}

				.post-description {
					font-size: 1rem;
				}

				.post-nav {
					flex-direction: column;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="post-shell">
				<aside class="toc" aria-label="文章目录">
					<div class="toc-title">本文目录</div>
					{
						tableOfContents.length > 0 ? (
							<ul class="toc-list">
								{tableOfContents.map((heading) => (
									<li class="toc-item">
										<a class="toc-link" href={`#${heading.slug}`}>
											{heading.text}
										</a>
									</li>
								))}
							</ul>
						) : (
							<div class="toc-empty">暂无标题</div>
						)
					}
				</aside>

				<article class="post-shell-inner">
					<header class="post-head">
						<div class="post-title-row">
							<h1 class="post-title">{title}</h1>
							<div class="post-meta">
								<FormattedDate date={pubDate} />
								<span class="meta-divider">|</span>
								<span>{category ?? '未分类'}</span>
							</div>
						</div>
						<p class="post-description">{description}</p>
						{
							displayTags.length > 0 && (
								<div class="tags" aria-label="tags">
									{displayTags.map((tag) => <span class="tag">{tag}</span>)}
								</div>
							)
						}
					</header>

					<div class="divider" aria-hidden="true"></div>

					<div class="content">
						<slot />
					</div>

					<nav class="post-nav" aria-label="文章导航">
						{previousPost ? (
							<a class="post-nav-link" href={`/blog/${previousPost.id}/`}>
								<span class="post-nav-label">上一篇</span>
								<span class="post-nav-title">{previousPost.title}</span>
							</a>
						) : (
							<div class="post-nav-empty" aria-hidden="true"></div>
						)}

						{nextPost ? (
							<a class="post-nav-link" href={`/blog/${nextPost.id}/`}>
								<span class="post-nav-label">下一篇</span>
								<span class="post-nav-title">{nextPost.title}</span>
							</a>
						) : (
							<div class="post-nav-empty" aria-hidden="true"></div>
						)}
					</nav>
				</article>
			</div>
		</main>
		<Footer />
		<script is:inline>
			const links = Array.from(document.querySelectorAll('.toc-link'));
			const headings = links
				.map((link) => {
					const id = link.getAttribute('href')?.slice(1);
					return id ? document.getElementById(id) : null;
				})
				.filter((heading) => heading);

			if (headings.length > 0) {
				const setActive = (id) => {
					links.forEach((link) => {
						const isActive = link.getAttribute('href') === `#${id}`;
						link.classList.toggle('is-active', isActive);
					});
				};

				const observer = new IntersectionObserver(
					(entries) => {
						const visible = entries
							.filter((entry) => entry.isIntersecting)
							.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

						if (visible[0]?.target?.id) {
							setActive(visible[0].target.id);
						}
					},
					{
						rootMargin: '-20% 0px -70% 0px',
						threshold: 0,
					},
				);

				headings.forEach((heading) => observer.observe(heading));

				const firstVisible = headings[0];
				if (firstVisible?.id) setActive(firstVisible.id);
			}
		</script>
	</body>
</html>
