---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import avatarImage from '../assets/Yuan.jpg';
import { GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE, PERSONAL_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1180px, calc(100% - 2rem));
				padding: 2.5rem 0 4rem;
			}

			.home-layout {
				display: grid;
				grid-template-columns: 240px minmax(0, 1fr);
				gap: 1.5rem;
				align-items: start;
			}

			.profile-card {
				position: fixed;
				top: 6rem;
				left: max(1rem, calc((100vw - 1180px) / 2 - 3rem));
				width: 280px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.72);
				border-radius: 12px;
				background:
					linear-gradient(
						180deg,
						rgba(255, 255, 255, 0.88) 0%,
						rgba(255, 255, 255, 0.76) 100%
					);
				backdrop-filter: blur(10px) saturate(1.08);
				-webkit-backdrop-filter: blur(10px) saturate(1.08);
				box-shadow:
					0 12px 30px rgba(0, 0, 0, 0.08),
					inset 0 1px 0 rgba(255, 255, 255, 0.92),
					inset 0 -1px 0 rgba(255, 255, 255, 0.32);
				box-sizing: border-box;
				padding: 1.25rem;
			}

			.profile-card::before {
				content: '';
				position: absolute;
				inset: 0;
				pointer-events: none;
				background:
					linear-gradient(
						135deg,
						rgba(255, 255, 255, 0.5) 0%,
						rgba(255, 255, 255, 0.12) 34%,
						rgba(255, 255, 255, 0) 68%
					);
			}

			.avatar-wrap {
				position: relative;
				display: inline-block;
				width: 168px;
				height: 168px;
				margin-bottom: 1rem;
			}

			.avatar-wrap::before,
			.avatar-wrap::after {
				content: '';
				position: absolute;
				inset: -10px;
				border: 3px solid rgba(121, 183, 255, 0.68);
				border-radius: 50%;
				box-shadow: 0 0 18px rgba(121, 183, 255, 0.3);
				animation: avatar-ripple 2.35s ease-out infinite;
			}

			.avatar-wrap::after {
				animation-delay: 1.4s;
			}

			.avatar {
				position: relative;
				z-index: 1;
				display: block;
				width: 168px;
				height: 168px;
				object-fit: cover;
				border-radius: 50%;
				border: 3px solid rgba(121, 183, 255, 0.72);
				box-shadow:
					0 14px 26px rgba(34, 41, 57, 0.14);
			}

			@keyframes avatar-ripple {
				0% {
					opacity: 0.72;
					transform: scale(0.98);
				}

				72%,
				100% {
					opacity: 0;
					transform: scale(1.22);
				}
			}

			.profile-card h1 {
				position: relative;
				margin: 0 0 0.35rem;
				color: rgb(var(--black));
				font-size: 1.65rem;
				line-height: 1.15;
			}

			.profile-card p {
				position: relative;
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
				line-height: 1.65;
			}

			.github-button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: calc(100% - 1rem);
				height: 38px;
				margin-top: 1rem;
				border: 1px solid rgba(255, 255, 255, 0.34);
				border-radius: 10px;
				background: rgba(64, 84, 128, 0.76);
				color: white;
				text-decoration: none;
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22);
				transition:
					background-color 0.2s ease,
					box-shadow 0.2s ease,
					transform 0.2s ease;
			}

			.github-button:hover {
				background: rgba(52, 70, 112, 0.88);
				box-shadow:
					0 10px 22px rgba(var(--gray), 22%),
					inset 0 1px 0 rgba(255, 255, 255, 0.28);
				transform: translateY(-1px);
			}

			.github-button svg {
				width: 20px;
				height: 20px;
			}

			.posts-section {
				grid-column: 2;
				min-width: 0;
				max-width: 820px;
				justify-self: center;
				width: 100%;
				transform: translateX(-1rem);
			}

			.posts-heading {
				display: flex;
				justify-content: space-between;
				align-items: end;
				gap: 1rem;
				margin-bottom: 1rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.42);
				padding-bottom: 0.75rem;
			}

			.posts-heading h2 {
				margin: 0;
				color: #fff;
				font-size: 1.35rem;
				text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
			}

			.posts-count {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}

			.post-list {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.post-card a {
				display: grid;
				gap: 0.7rem;
				padding: 1.45rem 1.55rem;
				border: 1px solid rgba(255, 255, 255, 0.62);
				border-radius: 10px;
				background:
					linear-gradient(
						180deg,
						rgba(255, 255, 255, 0.9) 0%,
						rgba(255, 255, 255, 0.8) 100%
					);
				box-shadow:
					0 10px 26px rgba(0, 0, 0, 0.08),
					inset 0 1px 0 rgba(255, 255, 255, 0.72);
				text-decoration: none;
				transition:
					border-color 0.2s ease,
					box-shadow 0.2s ease,
					transform 0.2s ease,
					background-color 0.2s ease;
			}

			.post-card a:hover {
				border-color: rgba(121, 183, 255, 0.58);
				box-shadow:
					0 16px 34px rgba(0, 0, 0, 0.12),
					inset 0 1px 0 rgba(255, 255, 255, 0.86);
				background:
					linear-gradient(
						180deg,
						rgba(255, 255, 255, 0.95) 0%,
						rgba(255, 255, 255, 0.86) 100%
					);
				transform: translateY(-2px);
			}

			.post-title {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				margin: 0;
				color: rgb(var(--black));
				font-size: 1.52rem;
				line-height: 1.25;
			}

			.post-title::before {
				content: '';
				display: inline-block;
				width: 6px;
				height: 0.95em;
				border-radius: 999px;
				background: #79b7ff;
				flex: 0 0 auto;
			}

			.post-description {
				margin: 0;
				color: rgba(var(--gray-dark), 0.72);
				font-size: 0.98rem;
				line-height: 1.7;
			}

			.post-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.65rem;
				color: rgba(var(--gray), 0.88);
				font-size: 0.88rem;
				line-height: 1.35;
			}

			.meta-item {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
			}

			.meta-item svg {
				width: 15px;
				height: 15px;
				color: rgba(var(--gray), 0.9);
			}

			.meta-divider {
				color: rgba(var(--gray), 62%);
			}

			@media (max-width: 820px) {
				main {
					width: min(100% - 1rem, 680px);
					padding-top: 1rem;
				}

				.home-layout {
					grid-template-columns: 1fr;
					gap: 1rem;
				}

				.posts-section {
					grid-column: auto;
					transform: none;
				}

				.profile-card {
					position: static;
					width: auto;
					display: grid;
					grid-template-columns: 96px minmax(0, 1fr);
					gap: 1rem;
					align-items: center;
				}

				.avatar-wrap {
					width: 96px;
					height: 96px;
					margin: 0;
				}

				.avatar-wrap::before,
				.avatar-wrap::after {
					inset: -8px;
				}

				.avatar {
					width: 96px;
					height: 96px;
				}

				.post-card a { padding: 1.15rem; border-radius: 8px; }
				.post-title { font-size: 1.2rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main transition:animate="fade">
			<div class="home-layout">
				<aside class="profile-card" aria-label="Profile">
					<div class="avatar-wrap">
						<Image
							class="avatar"
							src={avatarImage}
							alt={`${SITE_TITLE} avatar`}
							width={224}
							height={224}
							loading="eager"
							fetchpriority="high"
						/>
					</div>
					<div>
						<h1>Yuan</h1>
						<p>{PERSONAL_DESCRIPTION}</p>
						<p>{SITE_DESCRIPTION}</p>
						<a class="github-button" href={GITHUB_URL} target="_blank" rel="noreferrer" aria-label="GitHub">
							<svg viewBox="0 0 16 16" aria-hidden="true">
								<path
									fill="currentColor"
									d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
								/>
							</svg>
						</a>
					</div>
				</aside>

				<section class="posts-section" aria-labelledby="posts-title">
					<div class="posts-heading">
						<h2 id="posts-title">Posts</h2>
						<p class="posts-count">{posts.length} 篇</p>
					</div>
					<ul class="post-list">
						{
							posts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.id}/`}>
									<h3 class="post-title">{post.data.title}</h3>
									<p class="post-description">{post.data.description}</p>
									<div class="post-meta">
										<span class="meta-item">
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path
													fill="currentColor"
													d="M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1.5A2.5 2.5 0 0 1 22 6.5v12A2.5 2.5 0 0 1 19.5 21h-15A2.5 2.5 0 0 1 2 18.5v-12A2.5 2.5 0 0 1 4.5 4H6V3a1 1 0 0 1 1-1Zm12.5 8h-15v8.5a.5.5 0 0 0 .5.5h14a.5.5 0 0 0 .5-.5V10ZM5 6a.5.5 0 0 0-.5.5V8h15V6.5A.5.5 0 0 0 19 6H5Z"
												/>
											</svg>
											<FormattedDate date={post.data.pubDate} />
										</span>
										<span class="meta-divider">|</span>
										<span>{post.data.category ?? '未分类'}</span>
									</div>
								</a>
							</li>
						))
						}
					</ul>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>
