---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import avatarImage from '../assets/Yuan.jpg';
import { GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1180px, calc(100% - 2rem));
				padding: 2.5rem 0 4rem;
			}

			.home-layout {
				display: grid;
				grid-template-columns: 280px minmax(0, 1fr);
				gap: 2rem;
				align-items: start;
			}

			.profile-card {
				position: sticky;
				top: 1.5rem;
				border: 1px solid rgba(var(--gray), 18%);
				border-radius: 8px;
				background: rgba(255, 255, 255, 86%);
				box-shadow: 0 12px 34px rgba(var(--gray), 14%);
				padding: 1.25rem;
			}

			.avatar {
				display: block;
				width: 148px;
				height: 148px;
				object-fit: cover;
				border-radius: 50%;
				margin-bottom: 1rem;
			}

			.profile-card h1 {
				margin: 0 0 0.45rem;
				font-size: 1.45rem;
			}

			.profile-card p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
				line-height: 1.65;
			}

			.github-button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: calc(100% - 1rem);
				height: 38px;
				margin-top: 1rem;
				border: 0;
				border-radius: 10px;
				background: rgb(var(--gray));
				color: white;
				text-decoration: none;
				transition:
					background-color 0.2s ease,
					box-shadow 0.2s ease,
					transform 0.2s ease;
			}

			.github-button:hover {
				background: rgb(var(--gray-dark));
				box-shadow: 0 10px 22px rgba(var(--gray), 28%);
				transform: translateY(-1px);
			}

			.github-button svg {
				width: 20px;
				height: 20px;
			}

			.posts-section {
				min-width: 0;
			}

			.posts-heading {
				display: flex;
				justify-content: space-between;
				align-items: end;
				gap: 1rem;
				margin-bottom: 1rem;
				border-bottom: 1px solid rgba(var(--gray), 18%);
				padding-bottom: 0.75rem;
			}

			.posts-heading h2 {
				margin: 0;
				font-size: 1.35rem;
			}

			.posts-count {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}

			.post-list {
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.post-card a {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: 1rem;
				align-items: center;
				min-height: 92px;
				border: 1px solid rgba(var(--gray), 16%);
				border-radius: 8px;
				background: rgba(255, 255, 255, 82%);
				padding: 1rem 1.15rem;
				text-decoration: none;
				transition:
					border-color 0.2s ease,
					box-shadow 0.2s ease,
					transform 0.2s ease;
			}

			.post-card a:hover {
				border-color: rgba(var(--gray), 32%);
				box-shadow: 0 12px 30px rgba(var(--gray), 16%);
				transform: translateY(-1px);
			}

			.post-title {
				margin: 0 0 0.35rem;
				color: rgb(var(--black));
				font-size: 1.15rem;
				line-height: 1.35;
			}

			.post-description {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.92rem;
				line-height: 1.55;
			}

			.post-date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.86rem;
				white-space: nowrap;
			}

			@media (max-width: 820px) {
				main {
					width: min(100% - 1rem, 680px);
					padding-top: 1rem;
				}

				.home-layout {
					grid-template-columns: 1fr;
					gap: 1rem;
				}

				.profile-card {
					position: static;
					display: grid;
					grid-template-columns: 96px minmax(0, 1fr);
					gap: 1rem;
					align-items: center;
				}

				.avatar {
					width: 96px;
					height: 96px;
					margin: 0;
				}

				.post-card a {
					grid-template-columns: 1fr;
					gap: 0.55rem;
				}

				.post-date {
					white-space: normal;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="home-layout">
				<aside class="profile-card" aria-label="Profile">
					<Image class="avatar" src={avatarImage} alt={`${SITE_TITLE} avatar`} width={224} height={224} />
					<div>
						<h1>Yuan</h1>
						<p>{SITE_DESCRIPTION}</p>
						<a class="github-button" href={GITHUB_URL} target="_blank" rel="noreferrer" aria-label="GitHub">
							<svg viewBox="0 0 16 16" aria-hidden="true">
								<path
									fill="currentColor"
									d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
								/>
							</svg>
						</a>
					</div>
				</aside>

				<section class="posts-section" aria-labelledby="posts-title">
					<div class="posts-heading">
						<h2 id="posts-title">文章</h2>
						<p class="posts-count">{posts.length} 篇</p>
					</div>
					<ul class="post-list">
						{
							posts.map((post) => (
								<li class="post-card">
									<a href={`/blog/${post.id}/`}>
										<div>
											<h3 class="post-title">{post.data.title}</h3>
											<p class="post-description">{post.data.description}</p>
										</div>
										<p class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</a>
								</li>
							))
						}
					</ul>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>
