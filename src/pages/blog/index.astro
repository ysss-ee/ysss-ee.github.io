---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const uncategorized = '未分类';
const slugify = (value: string) =>
	value
		.trim()
		.toLowerCase()
		.replace(/[\s_]+/g, '-')
		.replace(/[^\p{L}\p{N}-]+/gu, '')
		.replace(/-+/g, '-');

const formatMonthDay = (date: Date) => date.toISOString().slice(5, 10);

const byYear = posts.reduce<Record<string, typeof posts>>((acc, post) => {
	const year = String(post.data.pubDate.getFullYear());
	(acc[year] ??= []).push(post);
	return acc;
}, {});

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

const categories = Object.entries(
	posts.reduce<Record<string, { count: number; name: string }>>((acc, post) => {
		const name = post.data.category ?? uncategorized;
		const key = slugify(name);
		acc[key] = acc[key] ?? { count: 0, name };
		acc[key].count += 1;
		return acc;
	}, {}),
).sort((a, b) => b[1].count - a[1].count);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`博客 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1180px, calc(100% - 2rem));
				padding: 2.5rem 0 4rem;
			}

			.section {
				margin-top: 1.25rem;
				padding: 1.15rem 1.25rem;
				border: 1px solid rgba(var(--gray), 16%);
				border-radius: 12px;
				background: rgba(255, 255, 255, 68%);
				box-shadow: 0 12px 28px rgba(var(--gray), 10%);
			}

			.section:first-child {
				margin-top: 0;
			}

			.section-title {
				margin: 0 0 1rem;
				font-size: 1.2rem;
			}

			.archive-list {
				display: grid;
				gap: 0.85rem;
			}

			details.year {
				border: 1px solid rgba(var(--gray), 12%);
				border-radius: 12px;
				background: rgba(255, 255, 255, 82%);
				overflow: hidden;
			}

			details.year[open] {
				background: rgba(242, 248, 255, 88%);
			}

			summary.year-summary {
				display: grid;
				grid-template-columns: 120px 24px auto 1fr;
				align-items: center;
				gap: 1rem;
				padding: 1rem 1.1rem;
				list-style: none;
				cursor: pointer;
				user-select: none;
			}

			summary.year-summary::-webkit-details-marker {
				display: none;
			}

			.year-label {
				font-size: 1.45rem;
				font-weight: 700;
				color: rgb(var(--black));
			}

			.year-dot {
				width: 12px;
				height: 12px;
				border: 3px solid rgb(86, 153, 235);
				border-radius: 999px;
				background: white;
			}

			.year-meta {
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}

			.year-arrow {
				justify-self: end;
				color: rgb(var(--gray));
				font-size: 1.1rem;
				transition: transform 0.2s ease;
			}

			details[open] .year-arrow {
				transform: rotate(90deg);
			}

			.year-posts {
				display: grid;
				border-top: 1px dashed rgba(var(--gray), 16%);
				padding: 0.7rem 1.1rem 0.95rem;
			}

			.archive-post {
				display: grid;
				grid-template-columns: 76px 28px minmax(0, 1fr);
				gap: 0.9rem;
				align-items: center;
				min-height: 42px;
			}

			.post-date {
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}

			.timeline {
				position: relative;
				display: flex;
				align-items: center;
				justify-content: center;
				align-self: stretch;
			}

			.timeline::before {
				content: '';
				position: absolute;
				top: 0;
				bottom: 0;
				left: 50%;
				width: 2px;
				background: rgba(var(--gray), 15%);
				transform: translateX(-50%);
			}

			.timeline-dot {
				position: relative;
				z-index: 1;
				width: 8px;
				height: 8px;
				border-radius: 999px;
				background: rgb(86, 153, 235);
			}

			.post-link {
				display: inline-flex;
				align-items: center;
				gap: 0.7rem;
				min-width: 0;
				color: inherit;
				text-decoration: none;
			}

			.post-link:hover .post-title {
				color: rgb(86, 153, 235);
			}

			.post-category {
				flex: none;
				padding: 0.2rem 0.5rem;
				border-radius: 8px;
				background: rgba(86, 153, 235, 14%);
				color: rgb(86, 153, 235);
				font-size: 0.82rem;
			}

			.post-title {
				margin: 0;
				color: rgb(var(--black));
				font-size: 1rem;
				line-height: 1.35;
			}

			.category-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
			}

			.category-card {
				display: block;
				padding: 1rem 1.1rem;
				border: 1px solid rgba(var(--gray), 14%);
				border-radius: 10px;
				background: rgba(255, 255, 255, 78%);
				color: inherit;
				text-decoration: none;
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					border-color 0.2s ease;
			}

			.category-card:hover {
				transform: translateY(-1px);
				border-color: rgba(var(--gray), 28%);
				box-shadow: 0 12px 26px rgba(var(--gray), 12%);
			}

			.category-name {
				margin: 0 0 0.25rem;
				font-size: 1.05rem;
			}

			.category-count {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}

			@media (max-width: 820px) {
				main {
					width: min(100% - 1rem, 680px);
					padding-top: 1rem;
				}

				summary.year-summary {
					grid-template-columns: 86px 20px auto 1fr;
					gap: 0.7rem;
				}

				.year-label {
					font-size: 1.25rem;
				}

				.archive-post {
					grid-template-columns: 58px 22px minmax(0, 1fr);
					gap: 0.6rem;
				}

				.post-link {
					flex-wrap: wrap;
					gap: 0.45rem;
				}

				.category-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main transition:animate="fade">
			<section class="section" aria-labelledby="archive-title">
				<h2 class="section-title" id="archive-title">归档</h2>
				<div class="archive-list">
					{
						years.map((year) => (
							<details class="year">
								<summary class="year-summary">
									<span class="year-label">{year}</span>
									<span class="year-dot" aria-hidden="true"></span>
									<span class="year-meta">{byYear[year].length} 篇文章</span>
									<span class="year-arrow" aria-hidden="true">›</span>
								</summary>
								<div class="year-posts">
									{byYear[year].map((post) => (
										<div class="archive-post">
											<span class="post-date">{formatMonthDay(post.data.pubDate)}</span>
											<span class="timeline" aria-hidden="true">
												<span class="timeline-dot"></span>
											</span>
											<a class="post-link" href={`/blog/${post.id}/`}>
												<span class="post-category">{post.data.category ?? uncategorized}</span>
												<h3 class="post-title">{post.data.title}</h3>
											</a>
										</div>
									))}
								</div>
							</details>
						))
					}
				</div>
			</section>

			<section class="section" aria-labelledby="category-title">
				<h2 class="section-title" id="category-title">分类</h2>
				<div class="category-grid">
					{
						categories.map(([slug, category]) => (
							<a class="category-card" href={`/blog/category/${slug}/`}>
								<h3 class="category-name">{category.name}</h3>
								<p class="category-count">{category.count} 篇文章</p>
							</a>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
