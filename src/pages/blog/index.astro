---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const slugify = (value: string) =>
	value
		.trim()
		.toLowerCase()
		.replace(/[\s_]+/g, '-')
		.replace(/[^\p{L}\p{N}-]+/gu, '')
		.replace(/-+/g, '-');

const byYear = posts.reduce<Record<string, typeof posts>>((acc, post) => {
	const year = String(post.data.pubDate.getFullYear());
	(acc[year] ??= []).push(post);
	return acc;
}, {});

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

const categories = Object.entries(
	posts.reduce<Record<string, { count: number; name: string }>>((acc, post) => {
		const name = post.data.category ?? '未分类';
		const key = slugify(name);
		acc[key] = acc[key] ?? { count: 0, name };
		acc[key].count += 1;
		return acc;
	}, {}),
).sort((a, b) => b[1].count - a[1].count);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`博客 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1180px, calc(100% - 2rem));
				padding: 2.5rem 0 4rem;
			}

			.page-header {
				margin-bottom: 1.25rem;
				padding: 1.25rem 1.35rem;
				border: 1px solid rgba(var(--gray), 16%);
				border-radius: 12px;
				background: rgba(255, 255, 255, 78%);
				box-shadow: 0 12px 30px rgba(var(--gray), 12%);
			}

			.page-header h1 {
				margin: 0 0 0.35rem;
				font-size: 2rem;
			}

			.page-header p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.96rem;
				line-height: 1.7;
			}

			.section {
				margin-top: 1.25rem;
				padding: 1.1rem 1.15rem;
				border: 1px solid rgba(var(--gray), 16%);
				border-radius: 12px;
				background: rgba(255, 255, 255, 76%);
				box-shadow: 0 12px 28px rgba(var(--gray), 10%);
			}

			.section-title {
				margin: 0 0 1rem;
				font-size: 1.15rem;
			}

			.archive-list {
				display: grid;
				gap: 0.85rem;
			}

			details.year {
				border-radius: 12px;
				background: rgba(255, 255, 255, 78%);
				border: 1px solid rgba(var(--gray), 14%);
				overflow: hidden;
			}

			details.year[open] {
				background: rgba(240, 246, 255, 88%);
				border-color: rgba(92, 150, 235, 30%);
			}

			summary.year-summary {
				display: grid;
				grid-template-columns: 112px 22px auto 1fr;
				align-items: center;
				gap: 1rem;
				padding: 1rem 1.1rem;
				list-style: none;
				cursor: pointer;
				user-select: none;
			}

			summary.year-summary::-webkit-details-marker {
				display: none;
			}

			.year-label {
				font-size: 1.35rem;
				font-weight: 700;
				color: rgb(var(--black));
			}

			.year-dot {
				width: 12px;
				height: 12px;
				border-radius: 50%;
				border: 3px solid rgba(86, 153, 235, 100%);
				background: white;
			}

			.year-meta {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				color: rgb(var(--gray));
				font-size: 0.94rem;
			}

			.year-arrow {
				justify-self: end;
				color: rgb(var(--gray));
				font-size: 1.15rem;
				transition: transform 0.2s ease;
			}

			details[open] .year-arrow {
				transform: rotate(90deg);
			}

			.year-posts {
				border-top: 1px dashed rgba(var(--gray), 18%);
				padding: 0.5rem 1.1rem 1rem 1.1rem;
			}

			.year-post {
				display: grid;
				grid-template-columns: 72px 18px 1fr 160px;
				gap: 1rem;
				align-items: center;
				padding: 0.85rem 0;
			}

			.year-date {
				color: rgb(var(--gray));
				font-size: 0.88rem;
				text-align: left;
			}

			.year-line {
				position: relative;
				display: flex;
				justify-content: center;
			}

			.year-line::before {
				content: '';
				position: absolute;
				top: -12px;
				bottom: -12px;
				left: 50%;
				width: 2px;
				background: rgba(var(--gray), 16%);
				transform: translateX(-50%);
			}

			.year-bullet {
				position: relative;
				z-index: 1;
				width: 8px;
				height: 8px;
				margin-top: 3px;
				border-radius: 50%;
				background: rgb(86, 153, 235);
			}

			.year-link {
				display: flex;
				align-items: center;
				gap: 0.7rem;
				min-width: 0;
				color: inherit;
				text-decoration: none;
			}

			.year-cat {
				flex: none;
				padding: 0.2rem 0.5rem;
				border-radius: 8px;
				background: rgba(86, 153, 235, 14%);
				color: rgb(86, 153, 235);
				font-size: 0.8rem;
			}

			.year-title {
				margin: 0;
				font-size: 1rem;
				line-height: 1.4;
			}

			.year-link:hover .year-title {
				color: rgb(86, 153, 235);
			}

			.category-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
			}

			.category-card {
				display: block;
				padding: 1rem 1.1rem;
				border: 1px solid rgba(var(--gray), 16%);
				border-radius: 12px;
				background: rgba(255, 255, 255, 80%);
				color: inherit;
				text-decoration: none;
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					border-color 0.2s ease;
			}

			.category-card:hover {
				transform: translateY(-1px);
				border-color: rgba(var(--gray), 30%);
				box-shadow: 0 12px 26px rgba(var(--gray), 14%);
			}

			.category-name {
				margin: 0 0 0.3rem;
				font-size: 1.05rem;
			}

			.category-count {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}

			@media (max-width: 820px) {
				main {
					width: min(100% - 1rem, 680px);
					padding-top: 1rem;
				}

				summary.year-summary {
					grid-template-columns: 88px 18px auto 1fr;
					gap: 0.7rem;
				}

				.year-post {
					grid-template-columns: 64px 14px 1fr;
				}

				.year-link {
					grid-column: 3;
				}

				.year-arrow {
					display: none;
				}

				.category-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="section" aria-labelledby="archive-title">
				<h2 class="section-title" id="archive-title">归档</h2>
				<div class="archive-list">
					{
						years.map((year) => (
							<details class="year">
								<summary class="year-summary">
									<span class="year-label">{year}</span>
									<span class="year-dot" aria-hidden="true"></span>
									<span class="year-meta">{byYear[year].length} 篇文章</span>
									<span class="year-arrow" aria-hidden="true">›</span>
								</summary>
								<div class="year-posts">
									{byYear[year].map((post) => (
										<div class="year-post">
											<div class="year-date">{post.data.pubDate.toISOString().slice(5, 10)}</div>
											<div class="year-line"><span class="year-bullet" aria-hidden="true"></span></div>
											<a class="year-link" href={`/blog/${post.id}/`}>
												<span class="year-cat">{post.data.category ?? '未分类'}</span>
												<h3 class="year-title">{post.data.title}</h3>
											</a>
										</div>
									))}
								</div>
							</details>
						))
					}
				</div>
			</section>

			<section class="section" aria-labelledby="category-title">
				<h2 class="section-title" id="category-title">分类</h2>
				<div class="category-grid">
					{
						categories.map(([slug, category]) => (
							<a class="category-card" href={`/blog/category/${slug}/`}>
								<h3 class="category-name">{category.name}</h3>
								<p class="category-count">{category.count} 篇文章</p>
							</a>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
