---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

const slugify = (value: string) =>
	value
		.trim()
		.toLowerCase()
		.replace(/[\s_]+/g, '-')
		.replace(/[^\p{L}\p{N}-]+/gu, '')
		.replace(/-+/g, '-');

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = posts.reduce<Record<string, { name: string; posts: typeof posts }>>((acc, post) => {
	const name = post.data.category ?? '未分类';
	const key = slugify(name);
	(acc[key] ??= { name, posts: [] }).posts.push(post);
	return acc;
}, {});

const categorySlug = Astro.params.category ?? '';
const current = categories[categorySlug] ?? { name: categorySlug, posts: [] };

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const toSlug = (value: string) =>
		value
			.trim()
			.toLowerCase()
			.replace(/[\s_]+/g, '-')
			.replace(/[^\p{L}\p{N}-]+/gu, '')
			.replace(/-+/g, '-');
	const slugs = new Map<string, string>();

	for (const post of posts) {
		const name = post.data.category ?? '未分类';
		slugs.set(toSlug(name), name);
	}

	return [...slugs.entries()].map(([category]) => ({
		params: { category },
	}));
}
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${current.name} - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1180px, calc(100% - 2rem));
				padding: 2.5rem 0 4rem;
			}

			.page-header {
				margin-bottom: 1.25rem;
				padding: 1.25rem 1.35rem;
				border: 1px solid rgba(var(--gray), 16%);
				border-radius: 12px;
				background: rgba(255, 255, 255, 78%);
				box-shadow: 0 12px 30px rgba(var(--gray), 12%);
			}

			.page-header h1 {
				margin: 0 0 0.35rem;
				font-size: 2rem;
			}

			.page-header p {
				margin: 0;
				color: rgb(var(--gray));
			}

			.post-list {
				display: grid;
				gap: 0.85rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.post-list a {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: 1rem;
				align-items: center;
				padding: 1rem 1.15rem;
				border: 1px solid rgba(var(--gray), 16%);
				border-radius: 12px;
				background: rgba(255, 255, 255, 80%);
				text-decoration: none;
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					border-color 0.2s ease;
			}

			.post-list a:hover {
				transform: translateY(-1px);
				border-color: rgba(var(--gray), 30%);
				box-shadow: 0 12px 26px rgba(var(--gray), 14%);
			}

			.post-title {
				margin: 0 0 0.3rem;
				font-size: 1.05rem;
			}

			.post-desc {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.92rem;
			}

			.post-date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.86rem;
				white-space: nowrap;
			}

			@media (max-width: 820px) {
				main {
					width: min(100% - 1rem, 680px);
					padding-top: 1rem;
				}

				.post-list a {
					grid-template-columns: 1fr;
					gap: 0.55rem;
				}

				.post-date {
					white-space: normal;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main transition:animate="fade">
			<section class="page-header">
				<h1>{current.name}</h1>
				<p>{current.posts.length} 篇文章</p>
			</section>

			<ul class="post-list">
				{
					current.posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<div>
									<h2 class="post-title">{post.data.title}</h2>
									<p class="post-desc">{post.data.description}</p>
								</div>
								<p class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
