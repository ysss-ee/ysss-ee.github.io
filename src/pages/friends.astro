---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import bwzAvatar from '../assets/friends/bwz.jpg';
import cdtAvatar from '../assets/friends/cdt.jpg';
import cklAvatar from '../assets/friends/ckl.webp';
import csnAvatar from '../assets/friends/csn.jpg';
import gwtAvatar from '../assets/friends/gwt.jpg';
import pshAvatar from '../assets/friends/psh.jpg';
import sjsAvatar from '../assets/friends/sjs.jpeg';
import wjsAvatar from '../assets/friends/wjs.png';
import yzjAvatar from '../assets/friends/yzj.png';
import zmhAvatar from '../assets/friends/zmh.jpg';
import githubAvatar from '../assets/platform/github.jpg';
import yeyingAvatar from '../assets/platform/yeying.jpg'
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const friends = [
	{ name: 'H2SO4C(哇是超级无敌ckl大神呐', link: 'https://h2so4.site', avatar: cklAvatar },
	{ name: 'EnderCrysta2', link: 'https://endercrysta2.xyz', avatar: bwzAvatar },
	{ name: '枫禾', link: 'https://fenghecsn.github.io/', avatar: csnAvatar },
	{ name: '_Dreamer', link: 'https://blog.stargazer-luciddream.top', avatar: pshAvatar },
	{ name: '马克朱佩琪', link: 'https://wjsblog.xyz', avatar: wjsAvatar },
	{ name: '黑蚊子多', link: 'https://heavensdoor1.top', avatar: cdtAvatar },
	{ name: 'scienct', link: 'https://scienct.top', avatar: gwtAvatar },
	{ name: 'fridayssheep', link: 'https://blog.fridayssheep.top', avatar: yzjAvatar },
	{ name: '偃木公', link: 'https://chalgen.online', avatar: sjsAvatar },
	{ name: 'SeSame', link: 'https://blog.minhan.host', avatar: zmhAvatar },
];

const recommendedSites = [
	{ name: 'Github', link: 'https://github.com', avatar: githubAvatar },
	{ name: '夜莺' , link: 'https://space.bilibili.com/279406515?spm_id_from=333.337.0.0' ,avatar: yeyingAvatar }
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`友链 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1180px, calc(100% - 2rem));
				padding: 2.5rem 0 4rem;
			}

			.friends-layout {
				display: grid;
				grid-template-columns: 240px minmax(0, 1fr);
				gap: 2rem;
				align-items: start;
			}

			.friends-nav {
				position: sticky;
				top: 6rem;
				padding: 1.15rem;
				border: 1px solid rgba(255, 255, 255, 0.65);
				border-radius: 14px;
				background:
					linear-gradient(
						180deg,
						rgba(255, 255, 255, 0.92) 0%,
						rgba(255, 255, 255, 0.78) 100%
					);
				backdrop-filter: blur(10px) saturate(1.08);
				-webkit-backdrop-filter: blur(10px) saturate(1.08);
				box-shadow:
					0 12px 30px rgba(0, 0, 0, 0.08),
					inset 0 1px 0 rgba(255, 255, 255, 0.8);
			}

			.friends-nav h1 {
				margin: 0 0 1rem;
				font-size: 1.8rem;
				line-height: 1.15;
			}

			.friend-tab {
				position: relative;
				display: block;
				width: 100%;
				padding: 0.55rem 0.65rem 0.55rem 0.9rem;
				border: 0;
				border-radius: 8px;
				background: transparent;
				color: rgb(var(--gray));
				font: inherit;
				font-size: 0.98rem;
				line-height: 1.35;
				text-align: left;
				cursor: pointer;
				transition:
					background-color 0.2s ease,
					color 0.2s ease;
			}

			.friend-tab:hover {
				background: rgba(255, 255, 255, 0.42);
				color: rgb(var(--gray-dark));
			}

			.friend-tab.is-active {
				color: rgb(var(--black));
				font-weight: 700;
			}

			.friend-tab.is-active::before {
				content: '';
				position: absolute;
				left: 0;
				top: 0.62rem;
				bottom: 0.62rem;
				width: 4px;
				border-radius: 999px;
				background: #79b7ff;
			}

			.friends-panel {
				display: none;
			}

			.friends-panel.is-active {
				display: block;
			}

			.friend-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 2.2rem 1.5rem;
				list-style: none;
				margin: 0;
				padding: 0.6rem 0 0;
			}

			.friend-card a {
				display: grid;
				justify-items: center;
				gap: 0.65rem;
				text-decoration: none;
			}

			.friend-avatar {
				width: 62px;
				height: 62px;
				border-radius: 50%;
				object-fit: cover;
				box-shadow: 0 6px 14px rgba(var(--gray), 18%);
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease;
			}

			.friend-card a:hover .friend-avatar {
				transform: translateY(-2px);
				box-shadow: 0 10px 22px rgba(121, 183, 255, 0.28);
			}

			.friend-name {
				margin: 0;
				text-align: center;
				color: rgba(255, 255, 255, 0.86);
				font-size: 0.8rem;
				line-height: 1.25;
				text-shadow: 0 1px 2px rgba(0, 0, 0, 0.28);
			}

			@media (max-width: 820px) {
				main {
					width: min(100% - 1rem, 680px);
					padding-top: 1rem;
				}

				.friends-layout {
					grid-template-columns: 1fr;
					gap: 1.25rem;
				}

				.friends-nav {
					position: static;
				}

				.friend-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}

			@media (max-width: 420px) {
				.friend-grid {
					grid-template-columns: 1fr;
				}

				.friend-avatar {
					width: 58px;
					height: 58px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main transition:animate="fade">
			<div class="friends-layout">
				<aside class="friends-nav" aria-label="友链导航">
					<h1>友链</h1>
					<button class="friend-tab is-active" type="button" data-target="friends-list">好友链接</button>
					<button class="friend-tab" type="button" data-target="recommended-list">推荐网站</button>
				</aside>

				<section>
					<div class="friends-panel is-active" id="friends-list">
						<ul class="friend-grid">
							{
								friends.map((friend) => (
									<li class="friend-card">
										<a href={friend.link} target="_blank" rel="noreferrer">
											<Image
												class="friend-avatar"
												src={friend.avatar}
												alt={`${friend.name} avatar`}
												width={144}
												height={144}
											/>
											<h2 class="friend-name">{friend.name}</h2>
										</a>
									</li>
								))
							}
						</ul>
					</div>

					<div class="friends-panel" id="recommended-list">
						<ul class="friend-grid">
							{
								recommendedSites.map((site) => (
									<li class="friend-card">
										<a href={site.link} target="_blank" rel="noreferrer">
											<Image
												class="friend-avatar"
												src={site.avatar}
												alt={`${site.name} avatar`}
												width={144}
												height={144}
											/>
											<h2 class="friend-name">{site.name}</h2>
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</section>
			</div>
		</main>
		<Footer />
		<script is:inline data-astro-rerun>
			(() => {
				const tabs = Array.from(document.querySelectorAll('.friend-tab'));
				const panels = Array.from(document.querySelectorAll('.friends-panel'));

				tabs.forEach((tab) => {
					tab.addEventListener('click', () => {
						const targetId = tab.dataset.target;

						tabs.forEach((item) => item.classList.toggle('is-active', item === tab));
						panels.forEach((panel) => panel.classList.toggle('is-active', panel.id === targetId));
					});
				});
			})();
		</script>
	</body>
</html>
