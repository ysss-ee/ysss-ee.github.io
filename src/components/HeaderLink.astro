---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalizePath = (path: string) => {
	const normalized = path.replace(import.meta.env.BASE_URL, '').replace(/\/$/, '');
	return normalized || '/';
};
const pathname = normalizePath(Astro.url.pathname);
const linkPath = normalizePath(href?.toString() ?? '/');
const subpath = pathname.match(/[^\/]+/g);
const isActive = linkPath === pathname || linkPath === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
</style>
