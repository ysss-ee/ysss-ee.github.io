<div class="site-background" aria-hidden="true" transition:name="site-background" transition:persist>
	<video
		class="site-background-media"
		autoplay
		muted
		loop
		playsinline
		preload="none"
		poster="/background.jpg"
		data-src="/wallpaper.mp4"
	></video>
	<div class="site-background-tint"></div>
</div>

<script is:inline>
	(() => {
		const loadBackgroundVideo = () => {
			const video = document.querySelector('.site-background-media[data-src]');
			if (!video) return;

			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const savesData = navigator.connection?.saveData;
			if (prefersReducedMotion || savesData) return;

			video.src = video.dataset.src;
			video.removeAttribute('data-src');
			video.load();
			video.play().catch(() => {});
		};

		const scheduleVideoLoad = () => {
			const start = () => window.setTimeout(loadBackgroundVideo, 1500);

			if ('requestIdleCallback' in window) {
				window.requestIdleCallback(start, { timeout: 3000 });
				return;
			}

			start();
		};

		if (document.readyState === 'complete') {
			scheduleVideoLoad();
			return;
		}

		window.addEventListener('load', scheduleVideoLoad, { once: true });
	})();
</script>

<style>
	.site-background {
		position: fixed;
		inset: 0;
		z-index: -2;
		overflow: hidden;
		background: #08101f url('/background.jpg') center / cover no-repeat;
		pointer-events: none;
	}

	.site-background-media {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
		transform: translateZ(0);
	}

	.site-background-tint {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(rgba(8, 12, 28, 0.18), rgba(8, 12, 28, 0.34));
	}

	@media (prefers-reduced-motion: reduce) {
		.site-background-media {
			display: none;
		}
	}
</style>
