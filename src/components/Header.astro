---
import BackgroundVideo from './BackgroundVideo.astro';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<BackgroundVideo />
<header>
	<nav>
		<h2>
			<a href="/">
				<svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						fill-rule="evenodd"
						d="M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20Zm3 3a7 7 0 1 1 0 14a7 7 0 1 1 0-14Z"
					/>
				</svg>
				<span>{SITE_TITLE}</span>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog/">Blog</HeaderLink>
			<HeaderLink href="/friends/">Friends</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0.75rem;
		z-index: 50;
		width: min(1180px, calc(100% - 2rem));
		margin: 0.75rem auto 0;
		padding: 0 1rem;
		background:
			linear-gradient(
				180deg,
				rgba(255, 255, 255, 0.96) 0%,
				rgba(255, 255, 255, 0.88) 100%
			);
		border: 1px solid rgba(255, 255, 255, 0.65);
		border-radius: 16px;
		backdrop-filter: blur(10px) saturate(1.08);
		-webkit-backdrop-filter: blur(10px) saturate(1.08);
		box-shadow:
			0 12px 30px rgba(0, 0, 0, 0.08),
			inset 0 1px 0 rgba(255, 255, 255, 0.75);
		box-sizing: border-box;
	}

	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}

	.moon-icon {
		width: 16px;
		height: 16px;
		color: #79b7ff;
		flex: 0 0 auto;
		overflow: visible;
	}

	nav {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 64px;
	}

	.internal-links {
		position: absolute;
		left: 50%;
		display: flex;
		gap: 1.6rem;
		align-items: center;
		transform: translateX(-50%);
	}

	nav a {
		position: relative;
		padding: 0.42rem 0.72rem;
		color: var(--black);
		border-radius: 8px;
		text-decoration: none;
		font-size: 0.92rem;
		line-height: 1.2;
		transition:
			background-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	nav a:hover {
		background: rgba(255, 255, 255, 0.45);
	}

	nav a.active {
		background: transparent;
		box-shadow: none;
		color: rgb(var(--black));
		font-weight: 700;
		text-decoration: none;
	}

	nav a.active::after {
		content: '';
		position: absolute;
		left: 0.72rem;
		right: 0.72rem;
		bottom: 0.16rem;
		height: 3px;
		border-radius: 999px;
		background: #79b7ff;
		box-shadow: 0 0 10px rgba(121, 183, 255, 0.42);
	}

	@media (max-width: 720px) {
		header {
			top: 0.5rem;
			width: min(100% - 0.5rem, 720px);
			margin-top: 0.5rem;
			padding: 0 0.75rem;
			border-radius: 14px;
		}

		nav {
			min-height: 58px;
		}

		.internal-links {
			position: static;
			gap: 0.35rem;
			transform: none;
		}

		nav a {
			padding: 0.4rem 0.5rem;
			font-size: 0.86rem;
		}
	}
</style>
