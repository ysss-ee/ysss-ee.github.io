---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">主页</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/friends">友链</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		width: min(1180px, calc(100% - 2rem));
		margin: 0.75rem auto 0;
		padding: 0 1rem;
		background: rgba(255, 255, 255, 92%);
		border: 1px solid rgba(var(--gray), 14%);
		border-radius: 16px;
		box-shadow: 0 12px 30px rgba(var(--gray), 12%);
		box-sizing: border-box;
	}

	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}

	nav {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 64px;
	}

	.internal-links {
		position: absolute;
		left: 50%;
		display: flex;
		gap: 1.6rem;
		align-items: center;
		transform: translateX(-50%);
	}

	nav a {
		padding: 0.42rem 0.72rem;
		color: var(--black);
		border-radius: 8px;
		text-decoration: none;
		font-size: 0.92rem;
		line-height: 1.2;
		transition:
			background-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	nav a:hover {
		background: rgba(255, 255, 255, 78%);
		box-shadow: 0 8px 20px rgba(var(--gray), 18%);
		transform: translateY(-1px);
	}

	nav a.active {
		background: rgba(255, 255, 255, 62%);
		box-shadow: inset 0 -3px 0 rgb(var(--gray));
		text-decoration: none;
	}

	@media (max-width: 720px) {
		header {
			width: min(100% - 1rem, 680px);
			margin-top: 0.5rem;
			padding: 0 0.75rem;
			border-radius: 14px;
		}

		nav {
			min-height: 58px;
		}

		.internal-links {
			position: static;
			gap: 0.35rem;
			transform: none;
		}

		nav a {
			padding: 0.4rem 0.5rem;
			font-size: 0.86rem;
		}
	}
</style>
