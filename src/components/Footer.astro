---
const bars = Array.from({ length: 72 });
---

<div class="music-bars" aria-hidden="true">
	{bars.map((_, index) => <span style={`--i: ${index}`}></span>)}
</div>

<footer>
	<div class="footer-text">期待下次见面</div>
</footer>
<style>
	footer {
		padding: 2.5em 1em 6em;
		background: transparent;
		color: rgb(var(--gray));
		text-align: center;
	}

	.music-bars {
		position: fixed;
		left: 50%;
		bottom: 1rem;
		z-index: 60;
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 0.28rem;
		width: min(1180px, calc(100% - 2rem));
		height: 46px;
		transform: translateX(-50%);
		pointer-events: none;
		opacity: 0.9;
	}

	.music-bars span {
		width: 4px;
		height: 12px;
		border-radius: 999px;
		background: linear-gradient(180deg, rgba(121, 183, 255, 0.96), rgba(255, 255, 255, 0.7));
		box-shadow: 0 0 10px rgba(121, 183, 255, 0.28);
		transform-origin: bottom;
		animation: music-wave 1.8s ease-in-out infinite;
		animation-delay: calc(var(--i) * -0.055s);
	}

	@keyframes music-wave {
		0%,
		100% {
			height: 12px;
			opacity: 0.55;
		}

		25% {
			height: 42px;
			opacity: 1;
		}

		50% {
			height: 18px;
			opacity: 0.72;
		}

		75% {
			height: 32px;
			opacity: 0.9;
		}
	}

	.footer-text {
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.98rem;
		line-height: 1.6;
	}
</style>
